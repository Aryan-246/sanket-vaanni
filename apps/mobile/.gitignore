# Generated by the Gradle build, not source.
#
# The WebView hand assets are packaged from `src/webview` and staged nowhere, so
# nothing is written under `src/` any more. This rule stays as a guard for
# checkouts made before that change, which still have the old copy on disk.
android/app/src/main/assets/hands/
# The JS bundle the debug build packages.
#
# The release variant does not need this: `bundleReleaseJsAndAssets` generates
# its own bundle into `build/generated/assets/react/release/` and merges it in.
# A copy under `src/main/assets` is therefore both redundant and fatal — it
# collides with the generated one and fails `mergeReleaseAssets` with
# "Duplicate resources". The debug variant is listed in `debuggableVariants`,
# so it generates no bundle of its own and needs one staged here to run without
# a Metro server attached.
#
# Staged by copying the release build's output:
#   cp build/generated/assets/react/release/index.android.bundle \
#      app/src/debug/assets/index.android.bundle
android/app/src/debug/assets/index.android.bundle

# Bundled drawable and raw assets generated from src/assets during build.
android/app/src/main/res/raw/src_assets_*
android/app/src/main/res/drawable-*/src_assets_*

# Environment & secrets
.env
.env.*
!.env.example

