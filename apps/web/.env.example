# Sanket Vaanni Web Dashboard (Next.js) — Environment Example
#
# Copy to `.env.local` in apps/web when developing the dashboard.
# Never place the Firebase Admin SDK private key or service account JSON here.

# --- Firebase Web Client Configuration ------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sanket-vaanni.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sanket-vaanni
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sanket-vaanni.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=133701606069
NEXT_PUBLIC_FIREBASE_APP_ID=1:133701606069:web:8f15f9d4d0e5ec5effbcfc
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-TYYC40RKLR

# --- Firebase Web Push (VAPID Public Key) ---------------------------------
# Public key pair from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates.
# Used by getToken(messaging, { vapidKey }) to authenticate the client subscription.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BIGRH2...
