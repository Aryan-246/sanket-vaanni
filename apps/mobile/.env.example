# Sanket Vaanni mobile — environment example
#
# Copy to `.env` in apps/mobile and adjust. `.env` is gitignored; this file is not.
#   PowerShell:  Copy-Item .env.example .env
#
# ## These values are baked into the bundle
#
# `react-native-dotenv` (see babel.config.js) substitutes them at BUILD time.
# Nothing here is read at runtime, so:
#
#   development -> restart Metro with a cache reset:
#                    npm start -- --reset-cache
#   installed app -> rebuild the APK. The phone is running the values it was
#                    compiled with, and editing this file will not change them.
#
# There are NO secrets in this project. Do not put any here — anything read via
# @env is inlined into the bundle and is therefore effectively public.
#
# The backend has its own separate `apps/backend/.env`. The two are read by
# different processes at different times; a variable in one is invisible to the
# other.

# Base URL of the Sanket Vaanni backend (apps/backend).
#
#   Android emulator  -> http://10.0.2.2:4000   (host loopback alias)
#   Physical device   -> http://<your-host-LAN-IP>:4000
#                        (find it with: ipconfig  — and run the backend with
#                         HOST=0.0.0.0 so it accepts connections from the phone)
#   iOS simulator     -> http://127.0.0.1:4000
#
# If unset, development falls back to the emulator/simulator default and
# production resolves to "not configured". The app works offline either way.
API_BASE_URL=http://10.0.2.2:4000

# Supabase Configuration
# The Project URL and Publishable Key for client-side authentication and RLS data access.
# Never place secret or service-role keys here.
#
# Both must be set for the app to offer an account at all: with either one
# missing, `config.isSupabaseConfigured` is false and the app reports that no
# account service is configured.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
