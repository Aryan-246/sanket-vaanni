# Sanket Vaanni backend — environment example
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#   PowerShell:  Copy-Item .env.example .env
#
# ## This file must never contain a real secret
#
# It is tracked by git. Anything written here is in the repository's history
# permanently, and rotating it afterwards does not remove it. Every value below
# is a placeholder or a harmless default.

# --- HTTP server ---------------------------------------------------------
# Host to bind. 127.0.0.1 keeps the dev server off the local network.
# Use 0.0.0.0 to reach it from a physical phone on the same Wi-Fi.
HOST=127.0.0.1

# Port to listen on. Keep in sync with the mobile app's API base URL.
PORT=4000

# --- Runtime -------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Fastify/pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Firebase Admin SDK --------------------------------------------------
# Absolute path to the Firebase service account JSON key file, stored OUTSIDE
# this repository. The file itself must never be copied in or committed.
# Leave blank to run without Firebase: the notification API then reports that
# it is unconfigured instead of failing at startup.
GOOGLE_APPLICATION_CREDENTIALS=

# --- SMTP / Nodemailer Email ---------------------------------------------
# SMTP host and port (465 for implicit SSL, 587 for STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# The authenticated sender account.
SMTP_USER=

# The SMTP password. For Gmail this is a 16-character App Password
# (Google Account > Security > App Passwords), not the account password.
# Leave blank to run without email: the email API then reports that it is
# unconfigured, and never claims a message was sent.
SMTP_PASS=

# Formatted sender address shown to recipients.
SMTP_FROM="Sanket Vaanni <no-reply@example.com>"

# --- Backend API Security ------------------------------------------------
# Shared secret protecting the server-to-server email and notification trigger
# routes. Generate a long random value; do not reuse one from anywhere else.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Leave blank to disable those routes, which then answer 503 rather than
# accepting anonymous calls.
API_INTERNAL_SECRET=

# --- Supabase ------------------------------------------------------------
# Required by the administration API, which is disabled until all three are
# set. It disables itself rather than falling back to something weaker.
#
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# The anon (public) key. Safe to ship in a client, and used here only to
# validate incoming access tokens.
SUPABASE_ANON_KEY=

# ## The service-role key
#
# DANGER. This key bypasses every row-level security policy in the database.
# It must never be sent to a client, never logged, never committed, and never
# pasted into a chat, an issue or a screenshot. Nothing in this project reads
# it except the administration middleware, and only after the caller has been
# authenticated as an active administrator.
#
# Leave it blank and the administration API stays off.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrator credential record -------------------------------------
# Written by `npm run provision:admin`, which generates the password and stores
# it here so the owner has one copy. These two are a RECORD, not configuration:
# nothing in the server reads them, and the administration API does not consult
# them. Authorization comes from `profiles.role`, read per request, so these
# values cannot grant anyone access and must not be treated as an allowlist.
#
# Leave them blank in this file. A real value here would be a committed
# secret, which is exactly what the script exists to avoid.
ADMIN_EMAIL=
ADMIN_PASSWORD=
