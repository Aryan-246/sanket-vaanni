# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Generated by the Gradle build, not source.
#
# The WebView hand assets are packaged from `src/webview` and staged nowhere, so
# nothing is written under `src/` any more. This rule stays as a guard for
# checkouts made before that change, which still have the old copy on disk.
android/app/src/main/assets/hands/
# The JS bundle the release build packages. Written here by `react-native
# bundle`, and regenerated by `bundleReleaseJsAndAssets` on every release build.
android/app/src/main/assets/index.android.bundle

# Bundled drawable and raw assets generated from src/assets during build.
android/app/src/main/res/raw/src_assets_*
android/app/src/main/res/drawable-*/src_assets_*

